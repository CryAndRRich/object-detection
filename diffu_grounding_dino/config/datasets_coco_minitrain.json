    "  python tools/coco2odvg.py --input ../data/coco_minitrain/annotations/instances_minitrain2017.json --output-jsonl ../data/coco_minitrain/annotations/minitrain_odvg.jsonl --output-label-map ../data/coco_minitrain/annotations/label_map.json",
