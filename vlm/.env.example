# ZETA5 / ZETA6 — chép thành vlm/.env rồi điền key (vlm/.env bị gitignore; KHÔNG commit, không dán key vào log / chat).
# Biến môi trường đã export sẵn được ưu tiên hơn file này.

# OpenAI (https://platform.openai.com/api-keys): GPT-6 Luna, gpt-4.1-mini — dùng TRƯỚC; trống / None / sai / hết tiền -> OpenRouter
OPENAI_API_KEY=

# OpenRouter (https://openrouter.ai/settings/keys): GLM-5.3-Flash; dự phòng cho GPT-6 Luna, gpt-4.1-mini
OPENROUTER_API_KEY=

# Google AI Studio (https://aistudio.google.com/apikey): Gemini Robotics-ER 2
GEMINI_API_KEY=
