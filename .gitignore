# MỘT .gitignore cho cả repo. tests/ ĐƯỢC đẩy lên server (chạy test trước job GPU).

# dữ liệu lớn — không push git, up thủ công lên server
weights/
# CHỈ data/ ở gốc repo. Không có dấu / đầu dòng thì rule này nuốt luôn package
# code ce_localization/data/ và diffuse2seg/data/ -> server pull về sẽ crash.
/data/
datasets/
samples/
samples_test/
samples_real/

# MỌI thư mục notebooks/ (notebook Kaggle) — chỉ ở local, không đẩy git. Notebook clone repo
# từ GitHub nên không cần nằm trong repo.
notebooks/

# kết quả / model (dấu / cuối: chỉ khớp THƯ MỤC, không khớp tên file). Mọi weight / checkpoint train ra nằm
# trong weights/ (ở trên) — KHÔNG dùng thư mục checkpoints/ nữa (người dùng, 2026-10-01)
output/
outputs/
*.pth
*.pkl
*.ckpt

# môi trường
.venv/
.venv-cpu/
venv/
env/
ENV/
.python-version

# python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
build/
dist/
.eggs/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# hệ điều hành / editor
.DS_Store
.idea/
.vscode/

# secret
.env
.envrc

# rác
tmp.py
*.log

# baseline/: repo ngoài clone ghim commit (Open-GroundingDino) — không vào git
baseline/third_party/
